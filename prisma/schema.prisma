datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Variant {
  SIX_DOWN
  ONE_TOUCH
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum RefRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

model Team {
  id            String        @id @default(uuid())
  name          String
  captainName   String
  captainPhone  String
  variant       Variant       @default(SIX_DOWN)
  totalFee      Decimal       @db.Decimal(10, 2)
  amountPaid    Decimal       @default(0.00) @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(UNPAID)
  players       Player[]
  homeMatches   Fixture[]     @relation("HomeTeam")
  awayMatches   Fixture[]     @relation("AwayTeam")
  createdAt     DateTime      @default(now())
}

model Player {
  id        String   @id @default(uuid())
  fullName  String
  email     String?
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Fixture {
  id          String   @id @default(uuid())
  pitchNumber Int
  scheduledAt DateTime
  homeTeamId  String
  homeTeam    Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId  String
  awayTeam    Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  refereeId   String?
  referee     User?    @relation(fields: [refereeId], references: [id])
}

model RefereeRequest {
  id              String           @id @default(uuid())
  tournamentName  String
  contactEmail    String
  eventDate       DateTime
  refsRequired    Int
  status          RefRequestStatus @default(PENDING)
  createdAt       DateTime         @default(now())
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  role      String    @default("REF") // ADMIN, REF
  fixtures  Fixture[]
}